# LeadPilot Environment Configuration Example

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadpilot?schema=public"

# Application Settings
NEXT_PUBLIC_APP_NAME="LeadPilot"
PORT=3000
NODE_ENV="development"

# Gmail SMTP Configuration (Use a Google App Password, NOT your normal Gmail password)
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_PROVIDER=smtp
EMAIL_FROM="LeadPilot Team <jaishankarpcservices2021@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jaishankarpcservices2021@gmail.com
SMTP_PASSWORD=dnvpkbklueyvulzy
UNSUBSCRIBE_SECRET=change-this-to-a-random-local-secret

# Optional Persistent WhatsApp Web Session Settings
# Mode: "auto" (uses persistent desktop browser if GUI is available, else falls back to browser tab) or "external"
WHATSAPP_SESSION_MODE="auto"
# Stored outside public/ and ignored by git
WHATSAPP_PROFILE_DIR=".whatsapp-profile"
